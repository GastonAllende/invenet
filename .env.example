# Database — Supabase Session Pooler connection string (not the Transaction pooler on 6543;
# EF Core needs prepared-statement support, which only Session mode / direct connections provide)
# ASP.NET Core reads this as ConnectionStrings__DefaultConnection
ConnectionStrings__DefaultConnection=postgres://postgres.afbbrzpkstrgnyagaavb:CHANGE_ME@aws-REGION.pooler.supabase.com:5432/postgres

# Supabase project URL — used to validate JWTs issued by Supabase Auth
Supabase__Url=https://afbbrzpkstrgnyagaavb.supabase.co

# CORS — comma-separated list of allowed frontend origins
Cors__Origins__0=http://localhost:4200
